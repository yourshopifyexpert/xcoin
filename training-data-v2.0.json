  "standard_format": {
    "description": "Standard normalized format for all transactions",
    "fields": {
      "timestamp": "Transaction date/time (ISO 8601)",
      "transaction_id": "Unique transaction identifier",
      "transaction_type": "Type of transaction (buy, sell, deposit, withdrawal, transfer, fee, staking, etc.)",
      "from_amount": "Amount sent/spent",
      "from_currency": "Currency sent (BTC, ETH, USD, etc.)",
      "to_amount": "Amount received",
      "to_currency": "Currency received",
      "fee_amount": "Transaction fee amount",
      "fee_currency": "Currency of fee",
      "price": "Price per unit (if applicable)",
      "price_currency": "Currency of price",
      "description": "Transaction description/notes",
      "exchange": "Source exchange/wallet",
      "wallet_address": "Wallet address (for deposits/withdrawals)",
      "status": "Transaction status (confirmed, pending, failed)"
    }
  },
  "column_patterns": {
    "timestamp": {
      "patterns": ["date", "time", "timestamp", "created", "tradeCreatedAt", "txTime", "block time", "created_at", "exec time", "execdate", "operation date", "transacted"],
      "variations": ["Date", "Time", "Timestamp", "Created At", "Trade Created At", "Transaction Time", "Created_At", "Exec Time", "ExecDate", "Operation Date", "Transacted"],
      "description": "When the transaction occurred"
    },
    "transaction_id": {
      "patterns": ["id", "txid", "tx_id", "transaction_id", "trade_id", "hash", "txhash", "reference", "order_id", "ordid"],
      "variations": ["ID", "TxID", "Tx ID", "Transaction ID", "Trade ID", "Hash", "Txhash", "Order ID", "OrdID"],
      "description": "Unique identifier for the transaction"
    },
    "from_amount": {
      "patterns": ["amount", "quantity", "qty", "size", "sell amount", "send amount", "buy_amount", "exec_amount", "input_amount"],
      "variations": ["Amount", "Quantity", "Qty", "Size", "Sell Amount", "Send Amount", "Buy Amount", "Exec Amount", "Input Amount"],
      "description": "Amount sent/spent"
    },
    "to_amount": {
      "patterns": ["total", "received", "buy amount", "receive amount", "output_amount", "output_qty"],
      "variations": ["Total", "Received", "Buy Amount", "Receive Amount", "Output Amount", "Output Qty"],
      "description": "Amount received"
    },
    "from_currency": {
      "patterns": ["currency", "coin", "asset", "symbol", "base-asset", "sell currency", "send currency", "buy_currency", "pair", "input_currency"],
      "variations": ["Currency", "Coin", "Asset", "Symbol", "Base-Asset", "Sell Currency", "Send Currency", "Buy Currency", "Pair", "Input Currency"],
      "description": "Currency sent"
    },
    "to_currency": {
      "patterns": ["quote-asset", "buy currency", "receive currency", "to currency", "output_currency", "output_asset"],
      "variations": ["Quote-Asset", "Buy Currency", "Receive Currency", "To Currency", "Output Currency", "Output Asset"],
      "description": "Currency received"
    },
    "price": {
      "patterns": ["price", "rate", "spot_price", "cost", "executed_price", "trade_price"],
      "variations": ["Price", "Rate", "Spot Price", "Cost", "Executed Price", "Trade Price"],
      "description": "Price per unit of currency"
    },
    "price_currency": {
      "patterns": ["price currency", "price_currency", "quote_currency"],
      "variations": ["Price Currency", "Price_Currency", "Quote Currency"],
      "description": "Currency of the price"
    },
    "fee_amount": {
      "patterns": ["fee", "fees", "commission", "fee_amount", "trading_fee", "transaction_fee"],
      "variations": ["Fee", "Fees", "Commission", "Fee Amount", "Trading Fee", "Transaction Fee"],
      "description": "Transaction fees or commissions"
    },
    "fee_currency": {
      "patterns": ["fee currency", "fee_currency", "fee_coin"],
      "variations": ["Fee Currency", "Fee_Currency", "Fee Coin"],
      "description": "Currency of the fee"
    },
    "transaction_type": {
      "patterns": ["type", "transaction_type", "trx_type", "method", "side", "operation_type", "kind", "operationtype"],
      "variations": ["Type", "Transaction Type", "Trx Type", "Method", "Side", "Operation Type", "Kind", "OperationType"],
      "description": "Type of transaction (buy, sell, deposit, etc.)"
    },
    "balance": {
      "patterns": ["balance", "running_balance", "balance_after", "balance_amount"],
      "variations": ["Balance", "Running Balance", "Balance After", "Balance Amount"],
      "description": "Account balance after transaction"
    },
    "description": {
      "patterns": ["description", "notes", "comment", "memo", "remark", "remarks"],
      "variations": ["Description", "Notes", "Comment", "Memo", "Remark", "Remarks"],
      "description": "Additional details about the transaction"
    },
    "exchange": {
      "patterns": ["exchange", "source", "exchange_name", "location", "platform"],
      "variations": ["Exchange", "Source", "Exchange Name", "Location", "Platform"],
      "description": "Source exchange or platform"
    },
    "wallet_address": {
      "patterns": ["address", "wallet", "wallet_address", "from", "to", "contract_address", "wallet_id"],
      "variations": ["Address", "Wallet", "Wallet Address", "From", "To", "Contract Address", "Wallet ID"],
      "description": "Wallet or public address"
    },
    "status": {
      "patterns": ["status", "state", "confirmed", "transaction_status"],
      "variations": ["Status", "State", "Confirmed", "Transaction Status"],
      "description": "Transaction status"
    },
    "unknown": {
      "patterns": [],
      "variations": [],
      "description": "Unknown or unmatched column"
    }
  },
  "transaction_types": {
    "buy": ["buy", "purchase", "bid", "long", "enter", "purchased", "buying"],
