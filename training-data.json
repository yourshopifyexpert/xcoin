{
  "column_mappings": {
    "binance": {
      "source": "Binance",
      "examples": [
        {
          "headers": ["time", "base-asset", "quote-asset", "type", "price", "quantity", "total", "fee", "fee-currency", "trade-id"],
          "type": "trade",
          "mappings": {
            "time": "timestamp",
            "base-asset": "from_currency",
            "quote-asset": "to_currency",
            "type": "transaction_type",
            "price": "price",
            "quantity": "from_amount",
            "total": "to_amount",
            "fee": "fee_amount",
            "fee-currency": "fee_currency",
            "trade-id": "transaction_id"
          }
        },
        {
          "headers": ["Deposit Time", "Coin", "Amount", "Deposit Address", "TransactionHash"],
          "type": "deposit",
          "mappings": {
            "Deposit Time": "timestamp",
            "Coin": "to_currency",
            "Amount": "to_amount",
            "Deposit Address": "wallet_address",
            "TransactionHash": "transaction_id"
          }
        }
      ]
    },
    "kraken": {
      "source": "Kraken",
      "examples": [
        {
          "headers": ["txid", "refid", "time", "type", "subtype", "aclass", "asset", "amount", "fee", "balance"],
          "type": "ledger",
          "mappings": {
            "txid": "transaction_id",
            "refid": "reference_id",
            "time": "timestamp",
            "type": "transaction_type",
            "subtype": "transaction_subtype",
            "aclass": "asset_class",
            "asset": "currency",
            "amount": "amount",
            "fee": "fee_amount",
            "balance": "running_balance"
          }
        }
      ]
    },
    "coinbase": {
      "source": "Coinbase",
      "examples": [
        {
          "headers": ["Timestamp", "Transaction Type", "Asset", "Quantity Transacted", "Spot Price Currency", "Spot Price at Transaction", "Subtotal", "Total (inclusive of fees and/or spread)", "Fees and/or Spread", "Notes"],
          "type": "transaction",
          "mappings": {
            "Timestamp": "timestamp",
            "Transaction Type": "transaction_type",
            "Asset": "currency",
            "Quantity Transacted": "amount",
            "Spot Price Currency": "price_currency",
            "Spot Price at Transaction": "price",
            "Subtotal": "subtotal",
            "Total (inclusive of fees and/or spread)": "total",
            "Fees and/or Spread": "fee_amount",
            "Notes": "description"
          }
        }
      ]
    },
    "koinly_universal": {
      "source": "Koinly Universal Format",
      "examples": [
        {
          "headers": ["Date", "Type", "Tag", "From Wallet ID", "From Amount", "From Currency", "To Wallet ID", "To Amount", "To Currency", "Fee Amount", "Fee Currency", "Description"],
          "type": "universal",
          "mappings": {
            "Date": "timestamp",
            "Type": "transaction_type",
            "Tag": "tag",
            "From Wallet ID": "from_wallet",
            "From Amount": "from_amount",
            "From Currency": "from_currency",
            "To Wallet ID": "to_wallet",
            "To Amount": "to_amount",
            "To Currency": "to_currency",
            "Fee Amount": "fee_amount",
            "Fee Currency": "fee_currency",
            "Description": "description"
          }
        }
      ]
    },
    "gemini": {
      "source": "Gemini",
      "examples": [
        {
          "headers": ["time", "base-asset", "quote-asset", "type", "description", "price", "quantity", "total", "fee", "fee-currency", "trade-id"],
          "type": "trade",
          "mappings": {
            "time": "timestamp",
            "base-asset": "from_currency",
            "quote-asset": "to_currency",
            "type": "transaction_type",
            "description": "description",
            "price": "price",
            "quantity": "from_amount",
            "total": "to_amount",
            "fee": "fee_amount",
            "fee-currency": "fee_currency",
            "trade-id": "transaction_id"
          }
        }
      ]
    },
    "etherscan": {
      "source": "Etherscan / Wallet Export",
      "examples": [
        {
          "headers": ["Timestamp", "Txhash", "BlockNumber", "Method", "From", "To", "Value_IN(ETH)", "Value_OUT(ETH)", "ContractAddress", "Gas_UsedGasPrice", "IsError", "TxnFee(ETH)"],
          "type": "blockchain",
          "mappings": {
            "Timestamp": "timestamp",
            "Txhash": "transaction_id",
            "BlockNumber": "block_number",
            "Method": "method",
            "From": "from_address",
            "To": "to_address",
            "Value_IN(ETH)": "from_amount",
            "Value_OUT(ETH)": "to_amount",
            "ContractAddress": "contract_address",
            "Gas_UsedGasPrice": "gas_price",
            "TxnFee(ETH)": "fee_amount"
          }
        }
      ]
    },
    "cointracking": {
      "source": "CoinTracking",
      "examples": [
        {
          "headers": ["Type", "Buy Amount", "Buy Currency", "Sell Amount", "Sell Currency", "Fee", "Fee Currency", "Exchange", "Trade-Group", "Comment", "Date"],
          "type": "trade",
          "mappings": {
            "Type": "transaction_type",
            "Buy Amount": "to_amount",
            "Buy Currency": "to_currency",
            "Sell Amount": "from_amount",
            "Sell Currency": "from_currency",
            "Fee": "fee_amount",
            "Fee Currency": "fee_currency",
            "Exchange": "exchange",
            "Trade-Group": "trade_group",
            "Comment": "description",
            "Date": "timestamp"
          }
        }
      ]
    },
    "poloniex": {
      "source": "Poloniex",
      "examples": [
        {
          "headers": ["Date", "Type", "Currency", "Amount", "Balance", "Status", "Comment"],
          "type": "activity",
          "mappings": {
            "Date": "timestamp",
            "Type": "transaction_type",
            "Currency": "currency",
            "Amount": "amount",
            "Balance": "running_balance",
            "Status": "status",
            "Comment": "description"
          }
        }
      ]
    },
    "kucoin": {
      "source": "KuCoin",
      "examples": [
        {
          "headers": ["tradeCreatedAt", "pair", "side", "price", "amount", "total", "fee", "feeCurrency"],
          "type": "trade",
          "mappings": {
            "tradeCreatedAt": "timestamp",
            "pair": "trading_pair",
            "side": "transaction_type",
            "price": "price",
            "amount": "from_amount",
            "total": "to_amount",
            "fee": "fee_amount",
            "feeCurrency": "fee_currency"
          }
        }
      ]
    }
  },
  "standard_format": {
    "description": "Standard normalized format for all transactions",
    "fields": {
      "timestamp": "Transaction date/time (ISO 8601)",
      "transaction_id": "Unique transaction identifier",
      "transaction_type": "Type of transaction (buy, sell, deposit, withdrawal, transfer, fee, staking, etc.)",
      "from_amount": "Amount sent/spent",
      "from_currency": "Currency sent (BTC, ETH, USD, etc.)",
      "to_amount": "Amount received",
      "to_currency": "Currency received",
      "fee_amount": "Transaction fee amount",
      "fee_currency": "Currency of fee",
      "price": "Price per unit (if applicable)",
      "price_currency": "Currency of price",
      "description": "Transaction description/notes",
      "exchange": "Source exchange/wallet",
      "wallet_address": "Wallet address (for deposits/withdrawals)",
      "status": "Transaction status (confirmed, pending, failed)"
    }
  },
  "column_patterns": {
    "timestamp": {
      "patterns": ["date", "time", "timestamp", "created", "tradeCreatedAt", "txTime", "block time"],
      "variations": ["Date", "Time", "Timestamp", "Created At", "Trade Created At", "Transaction Time"],
      "description": "When the transaction occurred"
    },
    "transaction_id": {
      "patterns": ["id", "txid", "tx_id", "transaction_id", "trade_id", "hash", "txhash", "reference"],
      "variations": ["ID", "TxID", "Tx ID", "Transaction ID", "Trade ID", "Hash", "Txhash"],
      "description": "Unique identifier for the transaction"
    },
    "from_amount": {
      "patterns": ["amount", "quantity", "qty", "size", "sell amount", "send amount"],
      "variations": ["Amount", "Quantity", "Qty", "Size", "Sell Amount", "Send Amount"],
      "description": "Amount sent/spent"
    },
    "to_amount": {
      "patterns": ["total", "received", "buy amount", "receive amount"],
      "variations": ["Total", "Received", "Buy Amount", "Receive Amount"],
      "description": "Amount received"
    },
    "from_currency": {
      "patterns": ["currency", "coin", "asset", "symbol", "base-asset", "sell currency", "send currency"],
      "variations": ["Currency", "Coin", "Asset", "Symbol", "Base-Asset", "Sell Currency", "Send Currency"],
      "description": "Currency sent"
    },
    "to_currency": {
      "patterns": ["quote-asset", "buy currency", "receive currency", "to currency"],
      "variations": ["Quote-Asset", "Buy Currency", "Receive Currency", "To Currency"],
      "description": "Currency received"
    },
    "price": {
      "patterns": ["price", "rate", "spot_price", "cost"],
      "variations": ["Price", "Rate", "Spot Price", "Cost", "Spot Price at Transaction"],
      "description": "Price per unit of currency"
    },
    "price_currency": {
      "patterns": ["price currency", "price_currency"],
      "variations": ["Price Currency", "Price_Currency"],
      "description": "Currency of the price"
    },
    "fee_amount": {
      "patterns": ["fee", "fees", "commission"],
      "variations": ["Fee", "Fees", "Commission", "Fees and/or Spread"],
      "description": "Transaction fees or commissions"
    },
    "fee_currency": {
      "patterns": ["fee currency", "fee_currency"],
      "variations": ["Fee Currency", "Fee_Currency"],
      "description": "Currency of the fee"
    },
    "transaction_type": {
      "patterns": ["type", "transaction_type", "trx_type", "method", "side"],
      "variations": ["Type", "Transaction Type", "Trx Type", "Method", "Side"],
      "description": "Type of transaction (buy, sell, deposit, etc.)"
    },
    "balance": {
      "patterns": ["balance", "running_balance", "balance_after"],
      "variations": ["Balance", "Running Balance", "Balance After"],
      "description": "Account balance after transaction"
    },
    "description": {
      "patterns": ["description", "notes", "comment", "memo"],
      "variations": ["Description", "Notes", "Comment", "Memo"],
      "description": "Additional details about the transaction"
    },
    "exchange": {
      "patterns": ["exchange", "source"],
      "variations": ["Exchange", "Source"],
      "description": "Source exchange or platform"
    },
    "wallet_address": {
      "patterns": ["address", "wallet", "wallet_address", "from", "to"],
      "variations": ["Address", "Wallet", "Wallet Address", "From", "To"],
      "description": "Wallet or public address"
    },
    "status": {
      "patterns": ["status", "state"],
      "variations": ["Status", "State"],
      "description": "Transaction status"
    },
    "unknown": {
      "patterns": [],
      "variations": [],
      "description": "Unknown or unmatched column"
    }
  },
  "transaction_types": {
    "buy": ["buy", "purchase", "bid", "long", "enter"],
    "sell": ["sell", "sale", "ask", "short", "exit"],
    "deposit": ["deposit", "in", "receive", "received", "incoming"],
    "withdrawal": ["withdrawal", "withdraw", "out", "send", "sent", "outgoing"],
    "transfer": ["transfer", "move", "swap", "exchange"],
    "fee": ["fee", "commission", "spread"],
    "staking": ["staking", "stake", "earn"],
    "reward": ["reward", "bonus", "airdrop", "referral"],
    "interest": ["interest", "yield"],
    "mining": ["mining", "mined"],
    "fork": ["fork", "fork reward"],
    "rebate": ["rebate", "cashback"]
  }
}
