  "standard_format": {
    "description": "Standard normalized format for all transactions",
    "fields": {
      "timestamp": "Transaction date/time (ISO 8601)",
      "transaction_id": "Unique transaction identifier",
      "transaction_type": "Type of transaction",
      "from_amount": "Amount sent/spent",
      "from_currency": "Currency sent",
      "to_amount": "Amount received",
      "to_currency": "Currency received",
      "fee_amount": "Transaction fee",
      "fee_currency": "Fee currency",
      "price": "Price per unit",
      "price_currency": "Price currency",
      "description": "Transaction notes",
      "exchange": "Source platform",
      "wallet_address": "Wallet address",
      "status": "Transaction status"
    }
  },
  "column_patterns": {
    "timestamp": {
      "patterns": ["date", "time", "timestamp", "created", "tradeCreatedAt", "txTime", "block time", "created_at", "exec time", "execdate", "operation date", "transacted", "datetime", "block", "height", "ledgerindex"],
      "variations": ["Date", "Time", "Timestamp", "Created At", "Trade Created At", "Transaction Time", "Created_At", "Exec Time", "ExecDate", "Operation Date", "Transacted", "DateTime", "Block", "Height", "LedgerIndex"],
      "description": "When transaction occurred"
    },
    "transaction_id": {
      "patterns": ["id", "txid", "tx_id", "transaction_id", "trade_id", "hash", "txhash", "reference", "order_id", "ordid", "signature", "txhash", "txn_hash"],
      "variations": ["ID", "TxID", "Tx ID", "Transaction ID", "Trade ID", "Hash", "Txhash", "Order ID", "OrdID", "Signature", "TxHash", "Txn Hash"],
      "description": "Unique transaction identifier"
    },
    "from_amount": {
      "patterns": ["amount", "quantity", "qty", "size", "sell amount", "send amount", "buy_amount", "exec_amount", "input_amount", "amountin"],
      "variations": ["Amount", "Quantity", "Qty", "Size", "Sell Amount", "Send Amount", "Buy Amount", "Exec Amount", "Input Amount", "AmountIn"],
      "description": "Amount sent/spent"
    },
    "to_amount": {
      "patterns": ["total", "received", "buy amount", "receive amount", "output_amount", "output_qty", "amountout"],
      "variations": ["Total", "Received", "Buy Amount", "Receive Amount", "Output Amount", "Output Qty", "AmountOut"],
      "description": "Amount received"
    },
    "from_currency": {
      "patterns": ["currency", "coin", "asset", "symbol", "base-asset", "sell currency", "send currency", "buy_currency", "pair", "input_currency", "token", "sendtoken"],
      "variations": ["Currency", "Coin", "Asset", "Symbol", "Base-Asset", "Sell Currency", "Send Currency", "Buy Currency", "Pair", "Input Currency", "Token", "SendToken"],
      "description": "Currency sent"
    },
    "to_currency": {
      "patterns": ["quote-asset", "buy currency", "receive currency", "to currency", "output_currency", "output_asset", "receivetoken"],
      "variations": ["Quote-Asset", "Buy Currency", "Receive Currency", "To Currency", "Output Currency", "Output Asset", "ReceiveToken"],
      "description": "Currency received"
    },
    "price": {
      "patterns": ["price", "rate", "spot_price", "cost", "executed_price", "trade_price", "filledprice"],
      "variations": ["Price", "Rate", "Spot Price", "Cost", "Executed Price", "Trade Price", "FilledPrice"],
      "description": "Price per unit"
    },
    "price_currency": {
      "patterns": ["price currency", "price_currency", "quote_currency", "pricecurrency"],
      "variations": ["Price Currency", "Price_Currency", "Quote Currency", "PriceCurrency"],
      "description": "Currency of price"
    },
    "fee_amount": {
      "patterns": ["fee", "fees", "commission", "fee_amount", "trading_fee", "transaction_fee", "spread", "gas", "gasprice"],
      "variations": ["Fee", "Fees", "Commission", "Fee Amount", "Trading Fee", "Transaction Fee", "Spread", "Gas", "GasPrice"],
      "description": "Transaction fees"
    },
    "fee_currency": {
      "patterns": ["fee currency", "fee_currency", "fee_coin", "feecurrency"],
      "variations": ["Fee Currency", "Fee_Currency", "Fee Coin", "FeeCurrency"],
      "description": "Fee currency"
    },
    "transaction_type": {
      "patterns": ["type", "transaction_type", "trx_type", "method", "side", "operation_type", "kind", "operationtype", "action", "category"],
      "variations": ["Type", "Transaction Type", "Trx Type", "Method", "Side", "Operation Type", "Kind", "OperationType", "Action", "Category"],
      "description": "Transaction type"
    },
    "balance": {
      "patterns": ["balance", "running_balance", "balance_after", "balance_amount"],
      "variations": ["Balance", "Running Balance", "Balance After", "Balance Amount"],
      "description": "Account balance"
    },
    "description": {
      "patterns": ["description", "notes", "comment", "memo", "remark", "remarks"],
      "variations": ["Description", "Notes", "Comment", "Memo", "Remark", "Remarks"],
      "description": "Transaction notes"
    },
    "exchange": {
      "patterns": ["exchange", "source", "exchange_name", "location", "platform", "chain", "network"],
      "variations": ["Exchange", "Source", "Exchange Name", "Location", "Platform", "Chain", "Network"],
      "description": "Source exchange"
    },
    "wallet_address": {
      "patterns": ["address", "wallet", "wallet_address", "from", "to", "contract_address", "wallet_id", "sender", "recipient"],
      "variations": ["Address", "Wallet", "Wallet Address", "From", "To", "Contract Address", "Wallet ID", "Sender", "Recipient"],
      "description": "Wallet address"
    },
    "status": {
      "patterns": ["status", "state", "confirmed", "transaction_status", "confirmations"],
      "variations": ["Status", "State", "Confirmed", "Transaction Status", "Confirmations"],
      "description": "Transaction status"
    },
    "unknown": {
      "patterns": [],
      "variations": [],
      "description": "Unknown column"
    }
  },
